# Endereco do cerebro central. Em teste local, localhost.
# Em duas maquinas de verdade, o IP ou dominio da maquina que roda o brain.
WS_BRAIN_URL=ws://localhost:8080

# Nome desta maquina, como ele vai aparecer na resposta do WhatsApp.
# Precisa ser unico entre as maquinas do time.
AGENT_NICK=PC-Daniel

# Precisa ser IDENTICO ao PAIRING_SECRET do cerebro central.
PAIRING_SECRET=troque-isto-por-um-valor-aleatorio-longo

# Pastas onde o Impetus procura projetos quando alguem pede "find" (achar,
# localizar, cade o projeto X). Cada SUBPASTA IMEDIATA de cada raiz listada
# aqui vira um "projeto" candidato — nao entra recursivamente dentro delas.
# Opcional: sem isso, este agente so responde "status"; find nao acha nada aqui.
# Separadas por virgula, caminho absoluto.
#
# TROQUE ISTO pelo caminho real desta maquina — "SeuUsuario" abaixo NAO existe,
# é so exemplo. Se voce colar sem editar, find nao encontra nada e nao avisa
# por que: o caminho errado so gera um aviso no log (nao trava o agente).
AGENT_INDEX_ROOTS=C:\Users\SeuUsuario\Documents\Codes\DMG

# Tamanho maximo (em MB) de arquivo/zip que este agente aceita enviar pelo
# WhatsApp via "shareFile". Existe pra ficar bem abaixo do limite de mensagem
# do transporte (100MB) mesmo apos a inflacao de ~33% do base64.
# Opcional: sem isso, o padrao e 20.
AGENT_MAX_FILE_MB=20
